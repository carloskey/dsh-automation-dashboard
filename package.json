{
  "name": "@carloskey/dsh-automation-dashboard",
  "version": "0.1.0",
  "type": "module",
  "description": "A read-only sci-fi dashboard for DSH automation tasks: status cards, an instrument readout bar and a grouped horizontal timeline, all read from the official schedule RPC.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "license": "MIT",
  "author": "carloskey",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carloskey/dsh-automation-dashboard.git"
  },
  "homepage": "https://github.com/carloskey/dsh-automation-dashboard#readme",
  "bugs": {
    "url": "https://github.com/carloskey/dsh-automation-dashboard/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "automation",
    "schedule",
    "dashboard"
  ],
  "engines": {
    "dsh": ">=0.2.0"
  },
  "scripts": {
    "test": "node test/smoke.mjs",
    "check": "node --check client.js && node --check index.js"
  }
}
